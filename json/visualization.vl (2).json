{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "data": {
    "url": "https://raw.githubusercontent.com/sid0025/DV2_2179/refs/heads/main/datasets/All-state-data-2026-05-06.csv"
  },
  "title": {
    "text": "Top 10 Shorebird Sites by Peak Count",
    "color": "#527298",
    "fontSize": 16
  },
  "transform": [
    {"calculate": "toNumber(datum['peak_sort'])", "as": "peak_num"},
    {
      "aggregate": [{"op": "max", "field": "peak_num", "as": "max_peak"}],
      "groupby": ["SBA"]
    },
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "max_peak", "order": "descending"}]
    },
    {"filter": "datum.rank <= 10"}
  ],
  "layer": [
    {
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "on": "mouseover", "clear": "mouseout"}
        }
      ],
      "mark": {"type": "bar", "color": "#527298", "cornerRadiusEnd": 4},
      "encoding": {
        "x": {
          "field": "max_peak",
          "type": "quantitative",
          "title": "Peak Count"
        },
        "y": {
          "field": "SBA",
          "type": "nominal",
          "title": "",
          "sort": {"encoding": "x", "order": "descending"}
        },
        "opacity": {
          "condition": {"param": "hover", "value": 1, "empty": true},
          "value": 0.4
        },
        "tooltip": [
          {"field": "SBA", "type": "nominal", "title": "Site"},
          {
            "field": "max_peak",
            "type": "quantitative",
            "title": "Peak Count",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 10,
        "color": "#527298"
      },
      "encoding": {
        "x": {"field": "max_peak", "type": "quantitative"},
        "y": {
          "field": "SBA",
          "type": "nominal",
          "sort": {"encoding": "x", "order": "descending"}
        },
        "text": {"field": "max_peak", "type": "quantitative", "format": ","}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 10,
        "color": "#FFFFFF",
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"field": "max_peak", "type": "quantitative"},
        "y": {
          "field": "SBA",
          "type": "nominal",
          "sort": {"encoding": "x", "order": "descending"}
        },
        "text": {
          "condition": {
            "test": "datum['SBA'] === 'Eighty Mile Beach'",
            "value": "◀ Australia's most critical shorebird site"
          },
          "value": ""
        }
      }
    }
  ],
  "config": {
    "font": "Lato",
    "scale": {"bandPaddingInner": 0.3},
    "background": "#F3FAF9",
    "view": {"continuousWidth": 600},
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "titleColor": "#527298",
      "labelColor": "#527298",
      "labelFont": "Lato",
      "labelFontSize": 12,
      "titleFontSize": 15
    }
  }
}