{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "title": {
    "text": "Bird Sighting Locations in Greater Geelong",
    "color": "#527298",
    "fontSize": 16
  },
  "projection": {
    "type": "mercator",
    "center": [144.45, -38.06],
    "scale": 36000
  },
  "params": [
    {
      "name": "species_filter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Australian Magpie",
          "Common Starling",
          "Little Raven",
          "Magpie-Lark",
          "Red Wattlebird",
          "Superb Fairy-wren",
          "Welcome Swallow",
          "Willie Wagtail"
        ],
        "name": "Filter by Species: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/sid0025/DV2_2179/refs/heads/main/datasets/geelong_boundary.json",
        "format": {"type": "json", "property": "geometries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#D9EDF7",
        "stroke": "#000000",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/sid0025/DV2_2179/refs/heads/main/datasets/geelong_birds.csv"
      },
      "transform": [
        {
          "filter": "species_filter === 'All' || datum.common_nam === species_filter"
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "on": "mouseover", "clear": "mouseout"}
        }
      ],
      "mark": {"type": "circle", "size": 20, "opacity": 0.6},
      "encoding": {
        "longitude": {"field": "long", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "color": {
          "field": "common_nam",
          "type": "nominal",
          "scale": {
            "domain": [
              "Australian Magpie",
              "Common Starling",
              "Little Raven",
              "Magpie-Lark",
              "Red Wattlebird",
              "Superb Fairy-wren",
              "Welcome Swallow",
              "Willie Wagtail"
            ],
            "range": [
              "#527298",
              "#5BA3A0",
              "#E8A838",
              "#7B5EA7",
              "#4E9BB9",
              "#F4A261",
              "#264653",
              "#A8DADC"
            ]
          },
          "legend": {
            "title": "Species",
            "titleColor": "#527298",
            "labelColor": "#527298",
            "labelFont": "Lato",
            "labelFontSize": "12"
          }
        },
        "opacity": {
          "condition": {"param": "hover", "value": 1, "empty": true},
          "value": 0.4
        },
        "tooltip": [
          {"field": "common_nam", "title": "Species"},
          {"field": "location", "title": "Location"},
          {"field": "start_date", "title": "Date"}
        ]
      }
    }
  ],
  "config": {"font": "Lato", "background": "#F3FAF9", "view": {"stroke": null}}
}