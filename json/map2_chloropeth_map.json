{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "title": {
    "text": "Shorebird Peak Counts by Australian State",
    "color": "#527298",
    "fontSize": 16
  },
  "projection": {"type": "mercator"},
  "data": {
    "url": "https://raw.githubusercontent.com/sid0025/DV2_2179/refs/heads/main/datasets/au_states.topojson",
    "format": {"type": "topojson", "feature": "data"}
  },
  "transform": [
    {
      "lookup": "properties.STE_NAME21",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/sid0025/DV2_2179/refs/heads/main/datasets/au_bird_totals.csv"
        },
        "key": "state_fullname",
        "fields": ["total_peak"]
      }
    },
    {"calculate": "toNumber(datum.total_peak)", "as": "total_peak_num"},
    {"filter": "datum.total_peak_num > 0"}
  ],
  "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.5},
  "encoding": {
    "color": {
      "field": "total_peak_num",
      "type": "quantitative",
      "scale": {"scheme": "blues", "type": "log"},
      "legend": {
        "title": "Total Peak Count",
        "titleColor": "#527298",
        "labelColor": "#527298",
        "labelFont": "Lato"
      }
    },
    "tooltip": [
      {"field": "properties.STE_NAME21", "title": "State"},
      {"field": "total_peak_num", "title": "Total Peak Count", "format": ","}
    ]
  },
  "config": {"font": "Lato", "background": "#F3FAF9", "view": {"stroke": null}}
}