{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/sid0025/DV2_2179/refs/heads/main/datasets/species.csv"
  },
  "title": {
    "text": "Top 10 Most Sighted Bird Species in Australia",
    "color": "#527298",
    "fontSize": 16
  },
  "transform": [
    {"calculate": "toNumber(datum['Count'])", "as": "CountNum"},
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "CountNum", "order": "descending"}]
    },
    {"filter": "datum.rank <= 10"}
  ],
  "layer": [
    {
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "on": "mouseover", "clear": "mouseout"}
        }
      ],
      "mark": {"type": "bar", "color": "#527298", "cornerRadiusEnd": 4},
      "encoding": {
        "x": {
          "field": "CountNum",
          "type": "quantitative",
          "title": "Sightings"
        },
        "y": {
          "field": "Common Name",
          "type": "nominal",
          "title": "",
          "sort": {"encoding": "x", "order": "descending"}
        },
        "tooltip": [
          {"field": "Common Name", "type": "nominal", "title": "Species"},
          {
            "field": "CountNum",
            "type": "quantitative",
            "title": "Sightings",
            "format": ","
          }
        ],
        "opacity": {
          "condition": {"param": "hover", "value": 1, "empty": true},
          "value": 0.4
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 11,
        "color": "#FFFFFF",
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"field": "CountNum", "type": "quantitative"},
        "y": {
          "field": "Common Name",
          "type": "nominal",
          "sort": {"encoding": "x", "order": "descending"}
        },
        "text": {
          "condition": {
            "test": "datum['Common Name'] === 'Australian Magpie'",
            "value": "◀ Most sighted bird in Australia"
          },
          "value": ""
        }
      }
    }
  ],
  "config": {
    "font": "Lato",
    "scale": {"bandPaddingInner": 0.3},
    "background": "#F3FAF9",
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "titleColor": "#527298",
      "labelColor": "#527298",
      "labelFont": "Lato",
      "labelFontSize": 13,
      "titleFontSize": 15
    }
  }
}