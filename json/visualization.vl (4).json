{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/sid0025/DV2_2179/refs/heads/main/datasets/All-state-data-2026-05-06.csv"
  },
  "title": {
    "text": "Peak Shorebird Counts by Species and State",
    "color": "#527298",
    "fontSize": 16
  },
  "params": [
    {
      "name": "state_filter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "EXT", "NSW", "NT", "QLD", "SA", "TAS", "VIC", "WA"],
        "name": "Filter by State: "
      }
    },
    {
      "name": "species_click",
      "select": {"type": "point", "fields": ["Species"], "on": "click"}
    }
  ],
  "transform": [
    {"calculate": "toNumber(datum['peak_sort'])", "as": "peak_num"},
    {
      "filter": "datum['Species'] !== 'Shorebird aggregation' && datum['Species'] !== 'Species diversity'"
    },
    {
      "joinaggregate": [
        {"op": "max", "field": "peak_num", "as": "species_max"}
      ],
      "groupby": ["Species"]
    },
    {"filter": "datum.species_max >= 10000"},
    {"filter": "state_filter === 'All' || datum['State'] === state_filter"}
  ],
  "mark": {"type": "circle"},
  "encoding": {
    "x": {
      "field": "State",
      "type": "nominal",
      "title": "State",
      "axis": {"labelAngle": 0}
    },
    "y": {"field": "Species", "type": "nominal", "title": ""},
    "size": {
      "aggregate": "max",
      "field": "peak_num",
      "type": "quantitative",
      "scale": {"range": [50, 2000]},
      "legend": {
        "title": "Peak Count",
        "titleColor": "#527298",
        "labelColor": "#527298",
        "labelFont": "Lato"
      }
    },
    "color": {"value": "#527298"},
    "opacity": {
      "condition": {"param": "species_click", "value": 0.9, "empty": true},
      "value": 0.15
    },
    "tooltip": [
      {"field": "Species", "type": "nominal", "title": "Species"},
      {"field": "State", "type": "nominal", "title": "State"},
      {
        "aggregate": "max",
        "field": "peak_num",
        "type": "quantitative",
        "title": "Peak Count",
        "format": ","
      }
    ]
  },
  "config": {
    "font": "Lato",
    "background": "#F3FAF9",
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": true,
      "gridColor": "#e0e0e0",
      "gridWidth": 0.5,
      "titleColor": "#527298",
      "labelColor": "#527298",
      "labelFont": "Lato",
      "labelFontSize": 12,
      "titleFontSize": 15
    },
    "legend": {
      "titleColor": "#527298",
      "labelColor": "#527298",
      "labelFont": "Lato"
    }
  }
}