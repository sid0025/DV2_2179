{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/sid0025/DV2_2179/refs/heads/main/datasets/All-state-data-2026-05-06.csv"
  },
  "title": {
    "text": "Summer vs Winter Peak Counts by Migratory Shorebird Species",
    "color": "#527298",
    "fontSize": 16
  },
  "transform": [
    {
      "filter": {
        "field": "Species",
        "oneOf": [
          "Red-necked Stint",
          "Sharp-tailed Sandpiper",
          "Far Eastern Curlew",
          "Bar-tailed Godwit"
        ]
      }
    }
  ],
  "params": [
    {
      "name": "season_select",
      "select": {"type": "point", "fields": ["Season"]},
      "bind": "legend"
    }
  ],
  "mark": {"type": "bar", "cornerRadiusEnd": 4},
  "encoding": {
    "x": {
      "field": "Species",
      "type": "nominal",
      "title": "",
      "axis": {"labelAngle": 0}
    },
    "xOffset": {"field": "Season", "type": "nominal"},
    "y": {
      "aggregate": "max",
      "field": "peak_sort",
      "type": "quantitative",
      "title": "Peak Count"
    },
    "color": {
      "field": "Season",
      "type": "nominal",
      "scale": {
        "domain": ["summer", "winter"],
        "range": ["#E8A838", "#527298"]
      },
      "legend": {
        "title": "Season",
        "orient": "top-right",
        "titleColor": "#527298",
        "labelColor": "#527298",
        "labelFont": "Lato",
        "labelFontSize": 12
      }
    },
    "tooltip": [
      {"field": "Species", "type": "nominal", "title": "Species"},
      {"field": "Season", "type": "nominal", "title": "Season"},
      {
        "aggregate": "max",
        "field": "peak_sort",
        "type": "quantitative",
        "title": "Peak Count",
        "format": ","
      }
    ],
    "opacity": {
      "condition": {"param": "season_select", "value": 1, "empty": true},
      "value": 0.2
    }
  },
  "config": {
    "font": "Lato",
    "background": "#F3FAF9",
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "titleColor": "#527298",
      "labelColor": "#527298",
      "labelFont": "Lato",
      "labelFontSize": 13,
      "titleFontSize": 15
    },
    "legend": {
      "titleColor": "#527298",
      "labelColor": "#527298",
      "labelFont": "Lato"
    }
  }
}
