{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/sid0025/DV2_2179/refs/heads/main/datasets/geelong_birds.csv"
  },
  "title": {
    "text": "Bird Sightings in Geelong Over Time",
    "color": "#527298",
    "fontSize": 16
  },
  "transform": [
    {"timeUnit": "year", "field": "start_date", "as": "year"},
    {
      "joinaggregate": [{"op": "count", "as": "species_total"}],
      "groupby": ["common_nam"]
    },
    {"filter": "datum.species_total >= 1400"}
  ],
  "autosize": {"type": "fit", "contains": "padding"},
  "vconcat": [
    {
      "width": "container",
      "height": 300,
      "layer": [
        {
          "params": [
            {
              "name": "species_select",
              "select": {"type": "point", "fields": ["common_nam"]},
              "bind": "legend"
            }
          ],
          "mark": {"type": "area", "opacity": 0.8},
          "encoding": {
            "x": {
              "field": "year",
              "type": "temporal",
              "title": "Year",
              "axis": {
                "format": "%Y",
                "tickCount": {"interval": "year", "step": 1}
              },
              "scale": {"domain": {"param": "brush"}}
            },
            "y": {
              "aggregate": "count",
              "type": "quantitative",
              "title": "Sightings",
              "scale": {"domain": [0, 1200]}
            },
            "color": {
              "field": "common_nam",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Australian Magpie",
                  "Common Starling",
                  "Little Raven",
                  "Magpie-Lark",
                  "Red Wattlebird",
                  "Superb Fairy-wren",
                  "Welcome Swallow",
                  "Willie Wagtail"
                ],
                "range": [
                  "#527298",
                  "#5BA3A0",
                  "#E8A838",
                  "#7B5EA7",
                  "#4E9BB9",
                  "#F4A261",
                  "#264653",
                  "#A8DADC"
                ]
              },
              "legend": {
                "title": "Species",
                "orient": "right",
                "titleColor": "#527298",
                "labelColor": "#527298",
                "labelFont": "Lato"
              }
            },
            "opacity": {
              "condition": {
                "param": "species_select",
                "value": 0.8,
                "empty": true
              },
              "value": 0.1
            },
            "tooltip": [
              {"field": "common_nam", "type": "nominal", "title": "Species"},
              {
                "field": "year",
                "type": "temporal",
                "title": "Year",
                "format": "%Y"
              },
              {
                "aggregate": "count",
                "type": "quantitative",
                "title": "Sightings"
              }
            ]
          }
        }
      ]
    },
    {
      "width": "container",
      "height": 60,
      "params": [
        {"name": "brush", "select": {"type": "interval", "encodings": ["x"]}}
      ],
      "mark": {"type": "area", "opacity": 0.6},
      "encoding": {
        "x": {
          "field": "year",
          "type": "temporal",
          "title": "Year",
          "axis": {"format": "%Y", "labelFontSize": 10}
        },
        "y": {
          "aggregate": "count",
          "type": "quantitative",
          "title": "Sightings",
          "axis": {"labels": false, "ticks": false, "grid": false}
        },
        "color": {
          "field": "common_nam",
          "type": "nominal",
          "scale": {
            "domain": [
              "Australian Magpie",
              "Common Starling",
              "Little Raven",
              "Magpie-Lark",
              "Red Wattlebird",
              "Superb Fairy-wren",
              "Welcome Swallow",
              "Willie Wagtail"
            ],
            "range": [
              "#527298",
              "#5BA3A0",
              "#E8A838",
              "#7B5EA7",
              "#4E9BB9",
              "#F4A261",
              "#264653",
              "#A8DADC"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "font": "Lato",
    "background": "#F3FAF9",
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "titleColor": "#527298",
      "labelColor": "#527298",
      "labelFont": "Lato",
      "labelFontSize": 13,
      "titleFontSize": 15
    },
    "legend": {
      "titleColor": "#527298",
      "labelColor": "#527298",
      "labelFont": "Lato",
      "labelFontSize": 12
    }
  }
}