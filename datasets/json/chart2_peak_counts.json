{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/sid0025/DV2_2179/refs/heads/main/datasets/All-state-data-2026-05-06.csv"
  },
  "title": {
    "text": "Peak Counts of Key Migratory Shorebirds Over Time",
    "color": "#527298",
    "fontSize": 16
  },
  "transform": [
    {
      "filter": {
        "field": "Species",
        "oneOf": [
          "Red-necked Stint",
          "Sharp-tailed Sandpiper",
          "Far Eastern Curlew",
          "Bar-tailed Godwit"
        ]
      }
    }
  ],
  "vconcat": [
    {
      "width": "container",
      "height": 320,
      "layer": [
        {
          "params": [
            {
              "name": "species_select",
              "select": {"type": "point", "fields": ["Species"]},
              "bind": "legend"
            }
          ],
          "mark": {"type": "line", "point": true, "strokeWidth": 2},
          "encoding": {
            "x": {
              "field": "Year",
              "type": "ordinal",
              "title": "Year",
              "scale": {"domain": {"param": "brush"}}
            },
            "y": {
              "aggregate": "max",
              "field": "peak_sort",
              "type": "quantitative",
              "title": "Peak Count",
              "axis": {"grid": true, "gridColor": "#e0e0e0", "gridWidth": 0.5}
            },
            "color": {
              "field": "Species",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Red-necked Stint",
                  "Sharp-tailed Sandpiper",
                  "Far Eastern Curlew",
                  "Bar-tailed Godwit"
                ],
                "range": ["#527298", "#5BA3A0", "#E8A838", "#7B5EA7"]
              },
              "legend": {
                "title": "Species",
                "orient": "bottom",
                "direction": "horizontal",
                "titleColor": "#527298",
                "labelColor": "#527298",
                "labelFont": "Lato",
                "labelFontSize": 12,
                "titleOrient": "left",
                "padding": 8,
                "columnPadding": 20
              }
            },
            "opacity": {
              "condition": {
                "param": "species_select",
                "value": 1,
                "empty": true
              },
              "value": 0.15
            },
            "tooltip": [
              {"field": "Species", "type": "nominal", "title": "Species"},
              {"field": "Year", "type": "ordinal", "title": "Year"},
              {
                "aggregate": "max",
                "field": "peak_sort",
                "type": "quantitative",
                "title": "Peak Count",
                "format": ","
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "dy": -10,
            "fontSize": 10,
            "color": "#7B5EA7"
          },
          "encoding": {
            "x": {
              "field": "Year",
              "type": "ordinal",
              "scale": {"domain": {"param": "brush"}}
            },
            "y": {
              "aggregate": "max",
              "field": "peak_sort",
              "type": "quantitative"
            },
            "color": {"field": "Species", "type": "nominal"},
            "opacity": {
              "condition": {
                "param": "species_select",
                "value": 1,
                "empty": true
              },
              "value": 0.15
            },
            "text": {
              "condition": {
                "test": "datum['Species'] === 'Bar-tailed Godwit' && datum['Year'] === '2013'",
                "value": "↑ Unusually high count in 2013"
              },
              "value": ""
            }
          }
        }
      ]
    },
    {
      "width": "container",
      "height": 60,
      "params": [
        {"name": "brush", "select": {"type": "interval", "encodings": ["x"]}}
      ],
      "mark": {"type": "line", "strokeWidth": 1.5},
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {"labelFontSize": 10}
        },
        "y": {
          "aggregate": "max",
          "field": "peak_sort",
          "type": "quantitative",
          "title": "Peak Count",
          "axis": {"labels": false, "ticks": false, "grid": false}
        },
        "color": {
          "field": "Species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Red-necked Stint",
              "Sharp-tailed Sandpiper",
              "Far Eastern Curlew",
              "Bar-tailed Godwit"
            ],
            "range": ["#527298", "#5BA3A0", "#E8A838", "#7B5EA7"]
          },
          "legend": null
        },
        "opacity": {
          "condition": {"param": "species_select", "value": 1, "empty": true},
          "value": 0.15
        }
      }
    }
  ],
  "config": {
    "font": "Lato",
    "scale": {"bandPaddingInner": 0.3},
    "background": "#F3FAF9",
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "titleColor": "#527298",
      "labelColor": "#527298",
      "labelFont": "Lato",
      "labelFontSize": 13,
      "titleFontSize": 15
    },
    "legend": {
      "titleColor": "#527298",
      "labelColor": "#527298",
      "labelFont": "Lato"
    }
  }
}
